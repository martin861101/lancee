{
  "mcpServers": {
    "graft": {
      "command": "npx",
      "args": [
        "-y",
        "@nanonets/graft",
        "mcp"
      ]
    },
    "mcp-grid-local": {
      "command": "node",
      "args": ["server/mcp-grid-server.mjs"],
      "env_vars": ["MCP_GATEWAY_URL", "MCP_API_TOKEN"],
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 130
    }
  }
}

# Application
APP_ENV=production
PORT=5177
PUBLIC_ORIGIN=https://lancee.hookitupservices.com

# Canonical business identity (used by legal pages, footers, and email footers).
# Server reads the bare names below; the client reads the VITE_-prefixed twins at
# build time. Set both to the same values. Unknown fields default to empty,
# documented placeholders and are omitted from rendered pages until configured.
PLATFORM_NAME=lancee
PLATFORM_LEGAL_STYLE=lancee, operated by Hookitup Pty (Ltd)
LEGAL_ENTITY_NAME=Hookitup Pty (Ltd)
COMPANY_REGISTRATION_NUMBER=
VAT_REGISTRATION_NUMBER=
REGISTERED_ADDRESS=
SUPPORT_EMAIL=
LEGAL_EMAIL=
INFORMATION_OFFICER_EMAIL=
JURISDICTION=South Africa
COUNTRY_CODE=ZA
CURRENCY=ZAR
VAT_REGISTERED=false
VITE_PLATFORM_NAME=lancee
VITE_PLATFORM_LEGAL_STYLE=lancee, operated by Hookitup Pty (Ltd)
VITE_LEGAL_ENTITY_NAME=Hookitup Pty (Ltd)
VITE_COMPANY_REGISTRATION_NUMBER=
VITE_VAT_REGISTRATION_NUMBER=
VITE_REGISTERED_ADDRESS=
VITE_SUPPORT_EMAIL=
VITE_LEGAL_EMAIL=
VITE_INFORMATION_OFFICER_EMAIL=
VITE_JURISDICTION=South Africa
VITE_COUNTRY_CODE=ZA
VITE_CURRENCY=ZAR
VITE_VAT_REGISTERED=false

# Initial administrator
ADMIN_NAME=Workspace Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_SALT=generate-with-npm-run-auth-hash
ADMIN_PASSWORD_HASH=generate-with-npm-run-auth-hash
SESSION_TTL_HOURS=12
WORKSPACE_ID=wsp_primary
WORKSPACE_NAME=Hookitup Solutions
# Local development fallback. Production and Docker Compose use PostgreSQL.
DATABASE_PATH=.runtime/lancee.sqlite
DATABASE_URL=
DATABASE_SSL=false
# Docker Compose database bootstrap (required when using docker compose).
POSTGRES_USER=lancee
POSTGRES_PASSWORD=
POSTGRES_DB=lancee_app
# Direct/managed PostgreSQL connection values.
PGHOST=
PGPORT=5432
PGUSER=lancee
PGPASSWORD=
PGDATABASE=lancee_app
PGPOOL_MAX=20
PGIDLE_TIMEOUT_MS=30000
PGCONNECT_TIMEOUT_MS=5000
REDIS_URL=redis://127.0.0.1:6379
REDIS_QUEUE_PREFIX=lancee
# Bounded child-process execution for the Lancee MCP execute_* tools. Disabled
# by default; enable only with an isolated worker/container and owner policy.
LANCEE_MCP_CODE_EXECUTION=false
LANCEE_MCP_PYTHON_BIN=python3
# The production Docker image supplies Chromium and sets the browser child to
# pwuser. Non-Docker deployments may set an explicit executable.
LANCEE_BROWSER_EXECUTABLE=
LANCEE_BROWSER_RUN_AS_USER=
SEED_DEMO_DATA=false
ALLOW_REGISTRATION=true

# Token vault (integration tokens are encrypted at rest with this master key).
# Generate a 64-character hex key: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Rotate by moving the current key to ENCRYPTION_MASTER_KEY_PREVIOUS and setting
# a new current key; rewrite existing integrations, then remove the previous key.
ENCRYPTION_MASTER_KEY=

# SMTP notifications
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=lancee
SMTP_FROM_EMAIL=
SMTP_REPLY_TO=
SMTP_TEST_TO=

# Workspace Messages mail connector
# Polling is clamped to a minimum of 30 seconds.
MAIL_SYNC_INTERVAL_MS=60000
# Development only. Production always rejects local/private mail server hosts.
MAIL_ALLOW_PRIVATE_HOSTS=false

# Server-side integrations
# Lancee serves its only MCP endpoint at /mcp. It uses workspace-scoped device
# tokens with the mcp:invoke scope, so no separate MCP gateway secret is needed.
N8N_BASE_URL=https://n8n.hygridtech.co.za
N8N_SIGNING_SECRET=
N8N_TIMEOUT_MS=10000
# Set both to true only when N8N_BASE_URL is a private, non-public Edge service.
N8N_ALLOW_PRIVATE=false
N8N_PRIVATE_NETWORK=false
# Required only for docker-compose.edge.yml.
N8N_IMAGE=
N8N_REDIS_PASSWORD=
N8N_ENCRYPTION_KEY=

# OpenConnector external integration gateway. Lancee calls it only from the
# backend and exposes the OAuth callback at /openconnector/oauth/callback.
# Generate three independent random values for production. The runtime token
# should be scoped in OpenConnector to the actions Lancee is allowed to use.
OPENCONNECTOR_ENABLED=true
OPENCONNECTOR_URL=http://127.0.0.1:3000
OPENCONNECTOR_TIMEOUT_MS=10000
OPENCONNECTOR_ADMIN_TOKEN=
OPENCONNECTOR_RUNTIME_TOKEN=
OPENCONNECTOR_ENCRYPTION_KEY=
OPENCONNECTOR_ALLOWED_ACTIONS=
OPENCONNECTOR_BLOCKED_ACTIONS=

# Paystack (server-side only)
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=https://lancee.hookitupservices.com/?payment=paystack

# Google Drive (OAuth)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=https://lancee.hookitupservices.com/oauth/callback
# Browser-restricted Google API key and Google Cloud project number for Picker.
GOOGLE_PICKER_API_KEY=
GOOGLE_PICKER_APP_ID=

# Zoom Meeting SDK (server-side only). Create a Meeting SDK app in the Zoom
# Marketplace and keep its secret out of all VITE_-prefixed variables.
ZOOM_MEETING_SDK_KEY=
ZOOM_MEETING_SDK_SECRET=

# AI / LLM integration
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.3
AI_ENDPOINT_URL=
AI_TIMEOUT_MS=30000

# Agent runtime selection. Leave AGENT_PROVIDER empty to select Hermes when its
# endpoint and API key are configured, otherwise use the Lancee runtime.
AGENT_PROVIDER=
AGENT_FALLBACK_PROVIDER=lancee
AGENT_FALLBACK_ENABLED=true
AGENT_TIMEOUT_MS=120000

# Hermes Agent native API server. The agent provider uses /v1/runs plus native
# sessions; completion-only calls continue to use the AI_* settings above.
HERMES_ENDPOINT_URL=http://127.0.0.1:8642
HERMES_API_KEY=
# Hermes requests are always routed to a named workspace profile. The default
# route is HERMES_ENDPOINT_URL/p/lancee_ws_<workspaceId>; use a template when
# the exposed server uses a different path. Provision the profile key(s) on
# Hermes and map them here for multi-workspace deployments.
HERMES_PROFILE_ENDPOINT_TEMPLATE=
HERMES_PROFILE_API_KEYS_JSON=
HERMES_MODEL=hermes-agent
HERMES_AGENT_TIMEOUT_MS=120000
HERMES_AGENT_POLL_MS=250
HERMES_AGENT_STREAM_EVENTS=true
# Native Hermes MEDIA: screenshots are imported from the profile's cache/images
# directories. Add comma-separated shared-volume roots when Hermes runs in a
# separate container. Imported images default to a 10 MB limit (maximum 25 MB).
HERMES_MEDIA_ROOTS=
HERMES_MEDIA_MAX_BYTES=10485760
# Hermes must be configured with a workspace-scoped Lancee MCP credential on
# the Hermes server. These values are status metadata only and never reach the browser.
HERMES_MCP_URL=
HERMES_MCP_AUTH_TOKEN=

# Native Codex App Server (server-side only)
CODEX_BINARY=codex
# Fixed repository/directory Codex is allowed to edit.
CODEX_WORKSPACE_ROOT=/workspace
# Host path mounted at /workspace by Docker Compose.
CODEX_WORKSPACE_PATH=.

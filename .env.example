# Application
APP_ENV=production
PORT=5177
PUBLIC_ORIGIN=https://agents.hygridtech.co.za

# Initial administrator
ADMIN_NAME=Workspace Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_SALT=generate-with-npm-run-auth-hash
ADMIN_PASSWORD_HASH=generate-with-npm-run-auth-hash
SESSION_TTL_HOURS=12
WORKSPACE_ID=wsp_primary
WORKSPACE_NAME=Hookitup Solutions
# Local development fallback. Production and Docker Compose use PostgreSQL.
DATABASE_PATH=.runtime/lancee.sqlite
DATABASE_URL=
DATABASE_SSL=false
# Docker Compose database bootstrap (required when using docker compose).
POSTGRES_USER=lancee
POSTGRES_PASSWORD=
POSTGRES_DB=lancee_app
# Direct/managed PostgreSQL connection values.
PGHOST=
PGPORT=5432
PGUSER=lancee
PGPASSWORD=
PGDATABASE=lancee_app
PGPOOL_MAX=20
PGIDLE_TIMEOUT_MS=30000
PGCONNECT_TIMEOUT_MS=5000
REDIS_URL=redis://127.0.0.1:6379
REDIS_QUEUE_PREFIX=lancee
# Bounded child-process execution for the Lancee MCP execute_* tools.
# Use a dedicated worker/container for production workloads.
LANCEE_MCP_CODE_EXECUTION=true
LANCEE_MCP_PYTHON_BIN=python3
SEED_DEMO_DATA=false
ALLOW_REGISTRATION=true

# Token vault (integration tokens are encrypted at rest with this master key).
# Generate a 64-character hex key: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Rotate by moving the current key to ENCRYPTION_MASTER_KEY_PREVIOUS and setting
# a new current key; rewrite existing integrations, then remove the previous key.
ENCRYPTION_MASTER_KEY=

# SMTP notifications
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=lancee
SMTP_FROM_EMAIL=
SMTP_REPLY_TO=
SMTP_TEST_TO=

# Workspace Messages mail connector
# Polling is clamped to a minimum of 30 seconds.
MAIL_SYNC_INTERVAL_MS=60000
# Development only. Production always rejects local/private mail server hosts.
MAIL_ALLOW_PRIVATE_HOSTS=false

# Server-side integrations
MCP_GATEWAY_URL=https://mcp.hygridtech.co.za
MCP_API_TOKEN=
# Business-system connections stay in the app backend. MCP defaults to agent tools.
MCP_ALLOWED_CATEGORIES=Browser,Utilities
# Basebox uses the standard authenticated MCP Streamable HTTP endpoint.
BASEBOX_MCP_URL=https://base-api.hygridtech.co.za/mcp
BASEBOX_MCP_ACCESS_KEY=
N8N_BASE_URL=https://n8n.hygridtech.co.za
N8N_SIGNING_SECRET=
N8N_TIMEOUT_MS=10000
# Set both to true only when N8N_BASE_URL is a private, non-public Edge service.
N8N_ALLOW_PRIVATE=false
N8N_PRIVATE_NETWORK=false
# Required only for docker-compose.edge.yml.
N8N_IMAGE=
N8N_REDIS_PASSWORD=
N8N_ENCRYPTION_KEY=

# Paystack (server-side only)
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=https://agents.hygridtech.co.za/?payment=paystack

# Google Drive (OAuth)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=https://agents.hygridtech.co.za/oauth/callback
# Browser-restricted Google API key and Google Cloud project number for Picker.
GOOGLE_PICKER_API_KEY=
GOOGLE_PICKER_APP_ID=

# AI / LLM integration
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.3
AI_ENDPOINT_URL=
AI_TIMEOUT_MS=30000

# Hermes Agent (OpenAI-compatible API server and optional fallback)
# AI_PROVIDER may be omitted when HERMES_ENDPOINT_URL is set; lancee selects Hermes automatically.
HERMES_ENDPOINT_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_MODEL=hermes-agent

# Native Codex App Server (server-side only)
CODEX_BINARY=codex
# Fixed repository/directory Codex is allowed to edit.
CODEX_WORKSPACE_ROOT=/workspace
# Host path mounted at /workspace by Docker Compose.
CODEX_WORKSPACE_PATH=.

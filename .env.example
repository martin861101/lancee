# Application
APP_ENV=production
PORT=5177
PUBLIC_ORIGIN=https://agents.hygridtech.co.za

# Initial administrator
ADMIN_NAME=Workspace Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_SALT=generate-with-npm-run-auth-hash
ADMIN_PASSWORD_HASH=generate-with-npm-run-auth-hash
SESSION_TTL_HOURS=12
WORKSPACE_ID=wsp_primary
WORKSPACE_NAME=Hookitup Solutions
# Local development fallback. Production and Docker Compose use PostgreSQL.
DATABASE_PATH=.runtime/lancee.sqlite
DATABASE_URL=
DATABASE_SSL=false
# Docker Compose database bootstrap (required when using docker compose).
POSTGRES_USER=lancee
POSTGRES_PASSWORD=
POSTGRES_DB=lancee_app
# Direct/managed PostgreSQL connection values.
PGHOST=
PGPORT=5432
PGUSER=lancee
PGPASSWORD=
PGDATABASE=lancee_app
PGPOOL_MAX=20
PGIDLE_TIMEOUT_MS=30000
PGCONNECT_TIMEOUT_MS=5000
SEED_DEMO_DATA=false
ALLOW_REGISTRATION=false

# SMTP notifications
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=lancee
SMTP_FROM_EMAIL=
SMTP_REPLY_TO=
SMTP_TEST_TO=

# Server-side integrations
MCP_GATEWAY_URL=https://mcp.hygridtech.co.za
MCP_API_TOKEN=
# Business-system connections stay in the app backend. MCP defaults to agent tools.
MCP_ALLOWED_CATEGORIES=Browser,Utilities
N8N_BASE_URL=https://n8n.hygridtech.co.za
N8N_SIGNING_SECRET=
N8N_TIMEOUT_MS=10000

# Paystack (server-side only)
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=https://agents.hygridtech.co.za/?payment=paystack

# Google Drive (OAuth)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=https://agents.hygridtech.co.za/oauth/callback

# AI / LLM integration
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.3
AI_ENDPOINT_URL=
AI_TIMEOUT_MS=30000

# Native Codex App Server (server-side only)
CODEX_BINARY=codex
# Fixed repository/directory Codex is allowed to edit.
CODEX_WORKSPACE_ROOT=/workspace
# Host path mounted at /workspace by Docker Compose.
CODEX_WORKSPACE_PATH=.
